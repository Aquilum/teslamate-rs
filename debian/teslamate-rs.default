# teslamate-rs environment (sourced by systemd). Uncomment to override.
# TESLAMATE_RS_HOME=/srv/teslamate-rs
# TESLAMATE_RS_DB=/srv/teslamate-rs/teslamate-rs.sqlite
# TESLAMATE_RS_BIND=127.0.0.1
# TESLAMATE_RS_PORT=4010
# TESLAMATE_RS_NO_LOGGER=1
# TESLAMATE_RS_AUTH=pam
# TESLAMATE_RS_PAM_SERVICE=teslamate-rs
# TESLAMATE_RS_PAM_GROUP=teslamate-rs
# TESLAMATE_RS_WEBAUTHN_ORIGIN=https://tm.example.com
# TESLAMATE_RS_WEBAUTHN_RP_ID=tm.example.com
