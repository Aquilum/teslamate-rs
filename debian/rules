#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# Cargo.toml asks for fat LTO with codegen-units = 1. Linking 169 crates
# that way, with the -C debuginfo=2 Debian needs for the dbgsym package,
# peaks high enough to get the build OOM-killed on a normal machine.
# "optimize=+lto" is read by /usr/share/cargo/bin/cargo and downgrades it
# to thin LTO, which keeps most of the benefit at a fraction of the peak.
# Use optimize=-lto to turn LTO off altogether if this is still too much.
export DEB_BUILD_OPTIONS += optimize=+lto

# The Debian cargo wrapper expects these to be exported; see the header of
# /usr/share/cargo/bin/cargo. teslamate-rs links libpam through the C ABI,
# so the hardening LDFLAGS do matter here.
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildflags.mk
include /usr/share/rustc/architecture.mk
export CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
export DEB_HOST_RUST_TYPE DEB_HOST_GNU_TYPE

# webauthn-rs is not packaged in Debian, so build without the "passkeys"
# feature. PAM and password authentication are unaffected.
# See debian/README.source.
CARGO_ARGS = --no-default-features

# The installsysusers sequence comes from the dh-sequence-installsysusers
# build dependency. dh_installsysusers only joins the default sequence at
# compat 14; without it the teslamate-rs user is never created,
# systemd-tmpfiles cannot chown /srv/teslamate-rs, and the unit fails to
# start because its User= does not exist.
%:
	dh $@ --buildsystem=cargo

override_dh_auto_test:
	dh_auto_test -- test $(CARGO_ARGS)

# dh-cargo installs the binary from [[bin]] into /usr/bin; the conffiles are
# ours and are not covered by the cargo buildsystem.
override_dh_auto_install:
	dh_auto_install -- $(CARGO_ARGS)
	install -D -m 0644 debian/teslamate-rs.default \
		debian/teslamate-rs/etc/default/teslamate-rs
	install -D -m 0644 debian/teslamate-rs.pam \
		debian/teslamate-rs/etc/pam.d/teslamate-rs
