[Unit]
Description=teslamate-rs one-shot PAM password check

[Service]
Type=simple
User=teslamate-rs
Group=shadow
EnvironmentFile=-/etc/default/teslamate-rs
ExecStart=/usr/bin/teslamate-rs pam-check
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=15
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=full
InaccessiblePaths=/srv/teslamate-rs
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=96M
TasksMax=16
AmbientCapabilities=
CapabilityBoundingSet=
UMask=0077
